{
  "name": "studypilot-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Study Pilot Chrome extension MVP: a single voice-first study companion panel injected on the page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:local": "tsc -b && vite build --mode studypilot-local",
    "build:e2e": "tsc -b && vite build --mode studypilot-e2e",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"e2e/**/*.{js,mjs,ts}\" \"*.{js,mjs,ts,json}\"",
    "lint": "eslint . --max-warnings 0 --no-error-on-unmatched-pattern",
    "quality": "node scripts/quality-check.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.34",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
